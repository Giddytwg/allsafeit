---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import heroImg from '../assets/images/Hero-image-optiized.avif';
import { faqSchema, orgSchema } from '../data/schemas';

import HeroSplit from '../components/sections/HeroSplit.astro';
import AwardMarquee from '../components/sections/AwardMarquee.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import ServiceCardGrid from '../components/sections/ServiceCardGrid.astro';
import TiredOfWaiting from '../components/sections/TiredOfWaiting.astro';
import StrategicSupport from '../components/sections/StrategicSupport.astro';
import ItServicesSection from '../components/sections/ItServicesSection.astro';
import TestimonialsSlider from '../components/sections/TestimonialsSlider.astro';
import IncAward from '../components/sections/IncAward.astro';
import IndustriesGrid from '../components/sections/IndustriesGrid.astro';
import TrustChecklist from '../components/sections/TrustChecklist.astro';
import BlogGrid from '../components/sections/BlogGrid.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import EbookCta from '../components/sections/EbookCta.astro';
import { HOME_FAQS } from '../data/faqs/home';
import LocationCards from '../components/sections/LocationCards.astro';
import ContactSection from '../components/sections/ContactSection.astro';

const heroPreload = await getImage({
  src: heroImg,
  widths: [400, 700, 800],
  format: 'webp',
});
---

<Base
  title="Managed IT Services California | AllSafe IT"
  description="7x CRN MSP 500 winner. AllSafe IT delivers managed IT services, cybersecurity & 24/7 support to California businesses. SOC 2 certified. Free IT assessment."
  canonical="https://www.allsafeit.com"
  schema={[faqSchema, orgSchema]}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroPreload.src}
      imagesrcset={heroPreload.srcSet.attribute}
      imagesizes="(max-width: 991px) 90vw, 50vw"
      fetchpriority="high"
    />
  </Fragment>

  <HeroSplit />
  <AwardMarquee />

  <SectionIntro heading="Proactive Managed IT Services in California">
    <p class="lead-text">You're tired of talking about tech support. We hear that. It's time for tech to support you.</p>
    <p class="lead-text">Many businesses across Southern California turn to our proactive managed IT services to escape reactive support and build technology that supports growth.</p>
    <p class="lead-text">We align your business technology with your objectives. Your team gets empowered. Your business grows, and you win. We want you to win.</p>
    <p class="lead-text"><a href="/locations/managed-it-services-los-angeles">Explore our managed IT services in Los Angeles</a></p>
  </SectionIntro>

  <ServiceCardGrid />
  <TiredOfWaiting />
  <StrategicSupport />
  <ItServicesSection />
  <TestimonialsSlider />
  <IncAward />
  <IndustriesGrid />
  <TrustChecklist />
  <BlogGrid />
  <FaqSection faqs={HOME_FAQS} heading="Common Questions About Managed IT Services in California" />
  <EbookCta />
  <LocationCards />
  <ContactSection />
</Base>

<script>
  const ebookSourceUrl = document.getElementById('ebook-source_url') as HTMLInputElement | null;
  if (ebookSourceUrl) ebookSourceUrl.value = window.location.href;
</script>

<style is:global>
  /* ── Button (reused across pages) ───────────────────────────── */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand-dark);
    color: var(--color-text-light);
    border-radius: var(--radius-default);
    padding: 14px 28px;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--text-lead);
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .button:hover { opacity: 0.85; }

  .button.small {
    padding: 10px 20px;
    font-size: var(--text-small);
  }

  /* ── Section title spacing ───────────────────────────────────── */
  .section-title {
    margin-top: var(--spacing-section-xs);
    margin-bottom: var(--spacing-section-xs);
  }
</style>
