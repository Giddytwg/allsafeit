---
import Base from '../layouts/Base.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import LocationCards from '../components/sections/LocationCards.astro';
---

<Base
  title="Contact AllSafe IT | Managed IT Services California"
  description="Contact AllSafe IT for managed IT services, cybersecurity, and IT consulting in California. Pasadena, Los Angeles, and Orange County offices. Free IT assessment."
  canonical="https://www.allsafeit.com/contact-us"
>
  <div class="contact-hero-wrap">
    <div aria-hidden="true" style="height: var(--navbar-height)"></div>
    <section class="section contact-hero">
      <div class="container">
        <div class="contact-hero-inner">
          <div class="badge-text contact-badge">[leave a message for us]</div>
          <h1 class="h3">Contact AllSafe IT for Reliable Business IT Solutions</h1>
          <p class="lead-text">Start with a conversation. No pressure, no decks — just an honest look at your technology situation and where we can help.</p>
        </div>
      </div>
    </section>
  </div>

  <ContactSection />
  <LocationCards />
</Base>

<style>
  .contact-hero-wrap {
    margin-top: var(--navbar-negative-height);
    background-color: var(--color-light-2);
  }

  .contact-hero {
    padding-bottom: 0;
  }

  .contact-hero-inner {
    max-width: var(--container-6col);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-badge {
    color: var(--color-accent);
  }
</style>
